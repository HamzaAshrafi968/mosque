APP_NAME="مؤسسة السَّفَرَة للعلوم والتنمية"
# الإنتاج: APP_ENV=production و APP_DEBUG=false إلزامياً
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---- الموقع العام (SEO): عدّل هذه القيم لتظهر في الصفحة الرئيسية وصفحات المساجد ----
SITE_NAME="${APP_NAME}"
SITE_SHORT_NAME=السفرة
SITE_PHONE=
SITE_EMAIL=
SITE_ADDRESS=
SITE_FACEBOOK=
SITE_WHATSAPP=
SITE_TELEGRAM=
SITE_YOUTUBE=
# SITE_OG_IMAGE=images/og-image.png

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# قاعدة البيانات الإنتاجية: MySQL (لا تستخدم SQLite في الإنتاج)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mosque
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# الإنتاج (HTTPS): فعّل الكوكي الآمن
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# الإنتاج: redis أسرع عند توفّره، وإلا file (سريع وبلا تبعيات)
CACHE_STORE=file
# CACHE_STORE=redis
# CACHE_PREFIX=

# صلاحية توكنات الـ API بالدقائق (7 أيام) — 0 = بلا انتهاء
SANCTUM_TOKEN_EXPIRATION=10080

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
